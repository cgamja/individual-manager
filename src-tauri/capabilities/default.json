{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, every pet window (pet-<id>), and the pinball field",
  "windows": [
    "main",
    "pet-*",
    "pinball-field-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default"
  ]
}
