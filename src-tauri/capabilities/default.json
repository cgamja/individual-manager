{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and every pet window (pet-<id>)",
  "windows": ["main", "pet-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "notification:default"
  ]
}
